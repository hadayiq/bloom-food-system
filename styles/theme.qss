/* =========================================================
   BLOOM FOOD - PREMIUM GLOBAL THEME
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

QWidget {
    background-color: #F7F9F7;
    color: #263238;

    font-family: "Segoe UI";
    font-size: 11pt;
}


/* =========================================================
   CONTENT AREA
   ========================================================= */

QStackedWidget {
    background-color: #F7F9F7;
}

QWidget#content_area {
    background-color: #F7F9F7;
}


/* =========================================================
   GLOBAL LABELS
   ========================================================= */

QLabel {
    background-color: transparent;
    color: #263238;
}


/* =========================================================
   PAGE TITLE
   ========================================================= */

QLabel#page_title {
    background-color: transparent;

    color: #2F6F35;

    font-family: "Segoe UI";
    font-size: 29pt;
    font-weight: 800;

    padding: 0px;
    margin: 0px;
}


/* =========================================================
   PAGE SUBTITLE
   ========================================================= */

QLabel#page_subtitle {
    background-color: transparent;

    color: #7B8580;

    font-family: "Segoe UI";
    font-size: 11pt;
    font-weight: 400;

    padding: 0px;
    margin: 3px 0px 8px 0px;
}


/* =========================================================
   SECTION TITLE
   ========================================================= */

QLabel#section_title {
    background-color: transparent;

    color: #2D3A35;

    font-family: "Segoe UI";
    font-size: 14pt;
    font-weight: 700;

    padding: 0px;
    margin: 0px;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

QFrame#sidebar {
    background-color: #FFFFFF;

    border: none;
    border-right: 1px solid #E3E9E3;
}


/* =========================================================
   COMPANY HEADER
   ========================================================= */

QLabel#company_name {
    background-color: transparent;

    color: #4FAE45;

    font-family: "Segoe UI";
    font-size: 20pt;
    font-weight: 800;

    padding: 0px;
    margin: 0px;
}


QLabel#company_subtitle {
    background-color: transparent;

    color: #8A958E;

    font-family: "Segoe UI";
    font-size: 9pt;
    font-weight: 400;

    padding: 0px;
    margin: 0px;
}


/* =========================================================
   SIDEBAR SEPARATOR
   ========================================================= */

QFrame#sidebar_line {
    background-color: #E8EDE8;

    border: none;

    min-height: 1px;
    max-height: 1px;
}


/* =========================================================
   SIDEBAR NAVIGATION
   ========================================================= */

QPushButton#sidebar_button {
    background-color: transparent;

    color: #52605A;

    border: none;
    border-radius: 10px;

    padding: 11px 14px;

    min-height: 44px;

    font-family: "Segoe UI";
    font-size: 10.5pt;
    font-weight: 600;

    text-align: right;

    qproperty-iconSize: 22px 22px;
}


/* =========================================================
   SIDEBAR HOVER
   ========================================================= */

QPushButton#sidebar_button:hover {
    background-color: #F0F7EE;

    color: #2F7135;
}


/* =========================================================
   SIDEBAR ACTIVE
   ========================================================= */

QPushButton#sidebar_button[active="true"] {
    background-color: #4FAE45;

    color: #FFFFFF;

    font-weight: 700;
}


/* =========================================================
   SIDEBAR ACTIVE HOVER
   ========================================================= */

QPushButton#sidebar_button[active="true"]:hover {
    background-color: #479E3E;

    color: #FFFFFF;
}


/* =========================================================
   SIDEBAR PRESSED
   ========================================================= */

QPushButton#sidebar_button:pressed {
    background-color: #3F8E38;

    color: #FFFFFF;
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

QLabel#sidebar_footer {
    background-color: transparent;

    color: #9AA49D;

    font-family: "Segoe UI";
    font-size: 8pt;
    font-weight: 400;

    padding: 8px 0px 2px 0px;
}


/* =========================================================
   GLOBAL BUTTONS
   ========================================================= */

QPushButton {
    background-color: #4FAE45;

    color: #FFFFFF;

    border: none;
    border-radius: 9px;

    padding: 9px 18px;

    min-height: 42px;

    font-family: "Segoe UI";
    font-size: 11pt;
    font-weight: 600;
}


/* Hover */

QPushButton:hover {
    background-color: #479E3E;
}


/* Pressed */

QPushButton:pressed {
    background-color: #3F8E38;
}


/* Disabled */

QPushButton:disabled {
    background-color: #D8DED8;
    color: #929A93;
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

QPushButton#primary_button {
    background-color: #4FAE45;

    color: #FFFFFF;

    border: none;
    border-radius: 10px;

    padding: 10px 35px;

    min-width: 160px;
    min-height: 44px;

    font-size: 11pt;
    font-weight: 700;
}


QPushButton#primary_button:hover {
    background-color: #479E3E;
}


QPushButton#primary_button:pressed {
    background-color: #3F8E38;
}


/* =========================================================
   SECONDARY BUTTON
   ========================================================= */

QPushButton#secondary_button {
    background-color: #FFFFFF;

    color: #52605A;

    border: 1px solid #D8E0D8;
    border-radius: 9px;

    padding: 9px 18px;

    min-height: 42px;

    font-weight: 600;
}


QPushButton#secondary_button:hover {
    background-color: #F1F7EF;

    color: #2F7135;

    border: 1px solid #B6CDB1;
}


QPushButton#secondary_button:pressed {
    background-color: #E5F0E2;
}


/* =========================================================
   DANGER BUTTON
   ========================================================= */

QPushButton#danger_button {
    background-color: #FFFFFF;

    color: #C0392B;

    border: 1px solid #E5BBB6;
    border-radius: 9px;

    padding: 9px 18px;

    min-height: 42px;

    font-weight: 600;
}


QPushButton#danger_button:hover {
    background-color: #FFF3F1;

    color: #B02A21;

    border: 1px solid #D9948C;
}


QPushButton#danger_button:pressed {
    background-color: #FCE4E0;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QComboBox,
QTextEdit {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #D9E0DA;
    border-radius: 9px;

    padding: 9px 12px;

    font-family: "Segoe UI";
    font-size: 10.5pt;
}


/* Hover */

QLineEdit:hover,
QComboBox:hover,
QTextEdit:hover {
    border: 1px solid #B8CDB4;
}


/* Focus */

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 2px solid #4FAE45;
}


/* =========================================================
   FORM LABELS
   ========================================================= */

QLabel#form_label {
    background-color: transparent;

    color: #374740;

    font-family: "Segoe UI";
    font-size: 10.5pt;
    font-weight: 600;

    padding: 0px;

    margin-top: 6px;
    margin-bottom: 5px;

    min-height: 24px;
}


/* =========================================================
   FORM INPUTS
   ========================================================= */

QLineEdit,
QComboBox {
    min-height: 45px;

    padding: 8px 12px;

    margin-top: 0px;
    margin-bottom: 8px;
}


QTextEdit {
    min-height: 110px;

    padding: 10px 12px;

    margin-top: 0px;
}


/* =========================================================
   TRANSACTION CARD
   ========================================================= */

QFrame#transaction_card {
    background-color: #FFFFFF;

    border: 1px solid #E1E7E1;
    border-radius: 16px;
}


/* =========================================================
   SUMMARY CARDS
   ========================================================= */

QFrame#summary_card {
    background-color: #FFFFFF;

    border: 1px solid #E2E8E2;
    border-radius: 14px;

    min-height: 110px;
}


QFrame#summary_card:hover {
    border: 1px solid #AFC8AA;
}


/* =========================================================
   CARD TITLE
   ========================================================= */

QLabel#card_title {
    background-color: transparent;

    color: #7A8580;

    font-size: 10pt;
    font-weight: 600;
}


/* =========================================================
   SUMMARY VALUES
   ========================================================= */

QLabel#products_value,
QLabel#in_value,
QLabel#out_value,
QLabel#balance_value {
    background-color: transparent;

    font-size: 21pt;
    font-weight: 800;
}


QLabel#products_value {
    color: #4FAE45;
}


QLabel#in_value {
    color: #3678A8;
}


QLabel#out_value {
    color: #D9862B;
}


QLabel#balance_value {
    color: #3E9550;
}


/* =========================================================
   KPI CARDS
   ========================================================= */

QFrame#kpi_card {
    background-color: #FFFFFF;

    border: 1px solid #E1E7E2;
    border-radius: 14px;

    min-height: 115px;
    max-height: 115px;
}


/* =========================================================
   KPI TITLE
   ========================================================= */

QLabel#kpi_title {
    background-color: transparent;

    color: #52605A;

    font-size: 10pt;
    font-weight: 600;

    padding: 0px;
}


/* =========================================================
   KPI VALUE
   ========================================================= */

QLabel#kpi_value {
    background-color: transparent;

    color: #263238;

    font-size: 24pt;
    font-weight: 800;

    padding: 0px;
}


/* =========================================================
   KPI GREEN
   ========================================================= */

QFrame#kpi_card[class="kpi_green"] {
    border-top: 4px solid #4FAE45;
}


QFrame#kpi_card[class="kpi_green"] QLabel#kpi_value {
    color: #4FAE45;
}


/* =========================================================
   KPI BLUE
   ========================================================= */

QFrame#kpi_card[class="kpi_blue"] {
    border-top: 4px solid #3678A8;
}


QFrame#kpi_card[class="kpi_blue"] QLabel#kpi_value {
    color: #3678A8;
}


/* =========================================================
   KPI ORANGE
   ========================================================= */

QFrame#kpi_card[class="kpi_orange"] {
    border-top: 4px solid #D9862B;
}


QFrame#kpi_card[class="kpi_orange"] QLabel#kpi_value {
    color: #D9862B;
}


/* =========================================================
   KPI PURPLE
   ========================================================= */

QFrame#kpi_card[class="kpi_purple"] {
    border-top: 4px solid #765A9F;
}


QFrame#kpi_card[class="kpi_purple"] QLabel#kpi_value {
    color: #765A9F;
}


/* =========================================================
   KPI ICON
   ========================================================= */

QLabel#kpi_icon {
    background-color: #F0F7EE;

    border-radius: 18px;

    padding: 6px;

    min-width: 28px;
    max-width: 28px;

    min-height: 28px;
    max-height: 28px;

    margin: 0px;
}


QFrame#kpi_card[class="kpi_green"] QLabel#kpi_icon {
    background-color: #EAF5E7;
}


QFrame#kpi_card[class="kpi_blue"] QLabel#kpi_icon {
    background-color: #EAF1F7;
}


QFrame#kpi_card[class="kpi_orange"] QLabel#kpi_icon {
    background-color: #FFF2E2;
}


QFrame#kpi_card[class="kpi_purple"] QLabel#kpi_icon {
    background-color: #F1ECF7;
}


/* =========================================================
   PRODUCT SEARCH
   ========================================================= */

QLineEdit#product_search {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #D9E2D8;
    border-radius: 30px;

    padding: 12px 22px;

    font-size: 13pt;
}


QLineEdit#product_search:focus {
    border: 2px solid #4FAE45;
}


/* =========================================================
   TOP PRODUCT SEARCH
   ========================================================= */

QLineEdit#top_product_search {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #D9E2D8;
    border-radius: 24px;

    padding: 10px 18px;

    font-size: 11pt;
}


QLineEdit#top_product_search:focus {
    border: 2px solid #4FAE45;
}


/* =========================================================
   SEARCH RESULTS
   ========================================================= */

QListWidget#product_search_results,
QListWidget#top_product_search_results {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #E0E7E0;
    border-radius: 12px;

    padding: 6px;

    font-size: 11pt;

    outline: none;
}


QListWidget#product_search_results::item,
QListWidget#top_product_search_results::item {
    padding: 12px 15px;

    min-height: 38px;

    border-radius: 8px;
}


QListWidget#product_search_results::item:hover,
QListWidget#top_product_search_results::item:hover {
    background-color: #F1F7EF;
}


QListWidget#product_search_results::item:selected,
QListWidget#top_product_search_results::item:selected {
    background-color: #E1F0DE;

    color: #25452A;
}


/* =========================================================
   TABLE SYSTEM
   ========================================================= */

QTableWidget {
    background-color: #FFFFFF;

    color: #26364A;

    border: 1px solid #E0E6E0;
    border-radius: 12px;

    gridline-color: transparent;

    font-family: "Segoe UI";
    font-size: 10.5pt;

    selection-background-color: #E3F1DF;
    selection-color: #243B27;

    alternate-background-color: #FAFCFA;

    outline: none;
}


/* =========================================================
   TABLE HEADER
   ========================================================= */

QTableWidget QHeaderView::section {
    background-color: #F2F6F1;

    color: #52605A;

    border: none;
    border-bottom: 1px solid #DDE5DC;

    padding: 12px 10px;

    font-family: "Segoe UI";
    font-size: 10.5pt;
    font-weight: 700;

    min-height: 38px;
}


/* =========================================================
   TABLE CELLS
   ========================================================= */

QTableWidget::item {
    padding: 10px 12px;

    border: none;
    border-bottom: 1px solid #EDF1ED;

    background-color: #FFFFFF;
}


/* =========================================================
   TABLE ALTERNATE ROWS
   ========================================================= */

QTableWidget::item:alternate {
    background-color: #FAFCFA;
}


/* =========================================================
   TABLE HOVER
   ========================================================= */

QTableWidget::item:hover {
    background-color: #F1F7EF;
}


/* =========================================================
   TABLE SELECTED
   ========================================================= */

QTableWidget::item:selected {
    background-color: #E1F0DE;

    color: #243B27;
}


/* =========================================================
   TABLE VERTICAL HEADER
   ========================================================= */

QTableWidget QHeaderView::section:vertical {
    background-color: #FFFFFF;

    color: #7A8580;

    border: none;
    border-right: 1px solid #E4EAE4;
    border-bottom: 1px solid #EDF1ED;

    padding: 6px;

    font-weight: 600;
}


/* =========================================================
   TABLE CORNER
   ========================================================= */

QTableCornerButton::section {
    background-color: #F2F6F1;

    border: none;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #D9E0DA;
    border-radius: 9px;

    padding: 9px 40px 9px 12px;

    min-height: 24px;

    font-family: "Segoe UI";
    font-size: 10.5pt;
}


/* =========================================================
   COMBO BOX DROP DOWN
   ========================================================= */

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    width: 34px;

    border: none;
    border-left: 1px solid #E4E9E4;

    background-color: #F8FAF8;

    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}


QComboBox::down-arrow {
    image: none;

    width: 0px;
    height: 0px;

    border-left: 5px solid transparent;
    border-right: 5px solid transparent;

    border-top: 6px solid #6B7670;
}


QComboBox::down-arrow:hover {
    border-top: 6px solid #4FAE45;
}


/* =========================================================
   COMBO BOX POPUP
   ========================================================= */

QComboBox QAbstractItemView {
    background-color: #FFFFFF;

    color: #263238;

    border: 1px solid #D9E0DA;
    border-radius: 8px;

    padding: 6px;

    outline: none;

    selection-background-color: #E5F1E2;
    selection-color: #263238;
}


QComboBox QAbstractItemView::item {
    min-height: 38px;

    padding: 8px 12px;

    border-radius: 6px;
}


QComboBox QAbstractItemView::item:hover {
    background-color: #F1F7EF;
}


QComboBox QAbstractItemView::item:selected {
    background-color: #E1F0DE;

    color: #263238;
}


/* =========================================================
   MESSAGE BOX
   ========================================================= */

QMessageBox {
    background-color: #FFFFFF;
}


QMessageBox QLabel {
    background-color: transparent;

    color: #263238;
}


QMessageBox QPushButton {
    min-width: 90px;
    min-height: 38px;
}


/* =========================================================
   GLOBAL SCROLLBAR - VERTICAL
   ========================================================= */

QScrollBar:vertical {
    background-color: transparent;

    width: 9px;

    margin: 2px;

    border: none;
}


QScrollBar::handle:vertical {
    background-color: #C5D1C1;

    min-height: 40px;

    border-radius: 5px;

    border: none;
}


QScrollBar::handle:vertical:hover {
    background-color: #8FB685;
}


QScrollBar::handle:vertical:pressed {
    background-color: #5BAE45;
}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;

    border: none;
    background: none;
}


QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* =========================================================
   GLOBAL SCROLLBAR - HORIZONTAL
   ========================================================= */

QScrollBar:horizontal {
    background-color: transparent;

    height: 9px;

    margin: 2px;

    border: none;
}


QScrollBar::handle:horizontal {
    background-color: #C5D1C1;

    min-width: 40px;

    border-radius: 5px;

    border: none;
}


QScrollBar::handle:horizontal:hover {
    background-color: #8FB685;
}


QScrollBar::handle:horizontal:pressed {
    background-color: #5BAE45;
}


QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;

    border: none;
    background: none;
}


QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* =========================================================
   END OF BLOOM FOOD PREMIUM THEME
   ========================================================= */