/* BLOOM FOOD — INPUT COMPONENTS
   Reference: Bloom Food UI design guide
   UI only — no business logic changes.
*/

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 7px;
    padding: 7px 11px;
    min-height: 36px;
    font-size: 10pt;
    selection-background-color: #DCEBFF;
    selection-color: #172033;
}

QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 7px;
    padding: 9px 11px;
    min-height: 88px;
    font-size: 10pt;
    selection-background-color: #DCEBFF;
    selection-color: #172033;
}

/* Hover */
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border: 1px solid #AFC4DF;
    background-color: #FFFFFF;
}

/* Focus — Bloom blue, matching the reference UI */
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #2563EB;
    padding: 6px 10px;
    background-color: #FFFFFF;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    padding: 8px 10px;
}

/* Disabled */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #F3F5F8;
    color: #8B95A5;
    border: 1px solid #E0E5EC;
}

/* Read-only */
QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"] {
    background-color: #F7F9FC;
}

/* Labels used above form controls */
QLabel#form_label {
    color: #172033;
    font-size: 9.5pt;
    font-weight: 700;
    background: transparent;
    padding: 0;
    margin: 0 0 5px 0;
    min-height: 20px;
}

/* ---------------------------------------------------------
   COMBOBOX — simple clean chevron on the RIGHT
   --------------------------------------------------------- */
QComboBox {
    padding-left: 11px;
    padding-right: 38px;
}

QComboBox:focus {
    padding-left: 10px;
    padding-right: 37px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(icons/dropdown_chevron.svg);
    width: 14px;
    height: 8px;
}

QComboBox::drop-down:hover {
    background: #F4F7FB;
    border-radius: 0 7px 7px 0;
}

QComboBox:on {
    border-color: #2563EB;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 8px;
    padding: 5px;
    outline: none;
    selection-background-color: #E8F1FF;
    selection-color: #1D4ED8;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 7px 10px;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F2F6FC;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #E8F1FF;
    color: #1D4ED8;
}

/* Numeric fields — clean, compact, no decorative icons */
QSpinBox,
QDoubleSpinBox {
    padding-left: 11px;
    padding-right: 11px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0;
    border: none;
    background: transparent;
}

/* Date field — clean, without decorative icons */
QDateEdit {
    padding-left: 11px;
    padding-right: 11px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url(icons/dropdown_chevron.svg);
    width: 14px;
    height: 8px;
}

/* Validation helpers */
QLabel#input_hint {
    color: #667085;
    font-size: 8.5pt;
    padding: 2px 2px 0 2px;
}

QLabel#input_error {
    color: #EF4444;
    font-size: 8.5pt;
    font-weight: 600;
    padding: 3px 2px 0 2px;
}

/* Transaction forms can be slightly roomier */
QFrame#transaction_card QLineEdit,
QFrame#transaction_card QComboBox,
QFrame#transaction_card QSpinBox,
QFrame#transaction_card QDoubleSpinBox,
QFrame#transaction_card QDateEdit {
    min-height: 38px;
}
