/* BLOOM FOOD — INPUT COMPONENTS
   Reference: Bloom Food UI design guide
   UI only — no business logic changes.
*/

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 7px;
    padding: 7px 11px;
    min-height: 36px;
    font-size: 10pt;
    selection-background-color: #DCEBFF;
    selection-color: #172033;
}

QTextEdit,
QPlainTextEdit {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 7px;
    padding: 9px 11px;
    min-height: 88px;
    font-size: 10pt;
    selection-background-color: #DCEBFF;
    selection-color: #172033;
}

/* Hover */
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border: 1px solid #AFC4DF;
    background-color: #FFFFFF;
}

/* Focus — Bloom blue, matching the reference UI */
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 2px solid #2563EB;
    padding: 6px 10px;
    background-color: #FFFFFF;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    padding: 8px 10px;
}

/* Disabled */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #F3F5F8;
    color: #8B95A5;
    border: 1px solid #E0E5EC;
}

/* Read-only */
QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"] {
    background-color: #F7F9FC;
}

/* Labels used above form controls */
QLabel#form_label {
    color: #172033;
    font-size: 9.5pt;
    font-weight: 700;
    background: transparent;
    padding: 0;
    margin: 0 0 5px 0;
    min-height: 20px;
}

/* ---------------------------------------------------------
   COMBOBOX — reference layout: arrow on the LEFT for RTL
   --------------------------------------------------------- */
QComboBox {
    padding-left: 38px;
    padding-right: 11px;
}

QComboBox:focus {
    padding-left: 37px;
    padding-right: 10px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    width: 30px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(icons/input_chevron_down.svg);
    width: 18px;
    height: 18px;
}

QComboBox:on {
    border-color: #2563EB;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DEE8;
    border-radius: 8px;
    padding: 5px;
    outline: none;
    selection-background-color: #E8F1FF;
    selection-color: #1D4ED8;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 7px 10px;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F2F6FC;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #E8F1FF;
    color: #1D4ED8;
}

/* ---------------------------------------------------------
   INPUT ICONS — same visual language as the reference sheet
   These use SVG assets from /icons and remain UI-only.
   --------------------------------------------------------- */
QLineEdit#product_search,
QLineEdit#top_product_search {
    min-height: 38px;
    border-radius: 7px;
    padding: 7px 38px 7px 12px;
    background-color: #FFFFFF;
    border: 1px solid #D7DEE8;
    background-image: url(icons/input_search.svg);
    background-repeat: no-repeat;
    background-position: right center;
}

QLineEdit#product_search:focus,
QLineEdit#top_product_search:focus {
    border: 2px solid #2563EB;
    padding: 6px 37px 6px 11px;
}

/* Optional semantic input object names used by form pages. */
QLineEdit#customer_name_input,
QLineEdit#client_name_input,
QLineEdit#representative_input {
    padding-right: 38px;
    background-image: url(icons/input_user.svg);
    background-repeat: no-repeat;
    background-position: right center;
}

QLineEdit#notes_search_input,
QLineEdit#search_input {
    padding-right: 38px;
    background-image: url(icons/input_search.svg);
    background-repeat: no-repeat;
    background-position: right center;
}

QLineEdit#product_name_input,
QLineEdit#item_name_input {
    padding-right: 38px;
    background-image: url(icons/input_box.svg);
    background-repeat: no-repeat;
    background-position: right center;
}

/* Numeric field — tag icon at the LEFT, as in the reference */
QDoubleSpinBox#quantity_input,
QSpinBox#quantity_input,
QDoubleSpinBox#amount_input,
QSpinBox#amount_input {
    padding-left: 38px;
    background-image: url(icons/input_tag.svg);
    background-repeat: no-repeat;
    background-position: left center;
}

/* Date field — calendar icon at the LEFT */
QDateEdit {
    padding-left: 38px;
    padding-right: 11px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    width: 30px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url(icons/input_calendar.svg);
    width: 18px;
    height: 18px;
}

/* Generic search fields without an object name */
QLineEdit[placeholderText*="بحث"] {
    padding-right: 38px;
    background-image: url(icons/input_search.svg);
    background-repeat: no-repeat;
    background-position: right center;
}

/* Numeric fields — clean, compact, no oversized arrows */
QSpinBox,
QDoubleSpinBox {
    padding-right: 11px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0;
    border: none;
    background: transparent;
}

/* Validation helpers */
QLabel#input_hint {
    color: #667085;
    font-size: 8.5pt;
    padding: 2px 2px 0 2px;
}

QLabel#input_error {
    color: #EF4444;
    font-size: 8.5pt;
    font-weight: 600;
    padding: 3px 2px 0 2px;
}

/* Transaction forms can be slightly roomier */
QFrame#transaction_card QLineEdit,
QFrame#transaction_card QComboBox,
QFrame#transaction_card QSpinBox,
QFrame#transaction_card QDoubleSpinBox,
QFrame#transaction_card QDateEdit {
    min-height: 38px;
}
