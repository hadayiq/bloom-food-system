/* BLOOM FOOD — UI KIT MASTER THEME */

* {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QWidget {
    background: #F7F9FC;
    color: #243447;
}

QMainWindow, QDialog {
    background: #F7F9FC;
}

QFrame, QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E5EAF0;
    border-radius: 10px;
}

QGroupBox {
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #243447;
    background: #FFFFFF;
}

QLabel {
    background: transparent;
    color: #34495E;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D7DEE8;
    border-radius: 7px;
    padding: 8px 10px;
    min-height: 18px;
    selection-background-color: #2F80ED;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QComboBox:focus {
    border: 1px solid #2F80ED;
}

QPushButton {
    background: #2F80ED;
    color: #FFFFFF;
    border: none;
    border-radius: 7px;
    padding: 9px 16px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #2169C7;
}

QPushButton:pressed {
    background: #1858AA;
}

QPushButton:disabled {
    background: #B8C2CF;
    color: #EEF2F6;
}

QPushButton[class="secondary"], QPushButton#secondaryButton {
    background: #EEF3F8;
    color: #34495E;
    border: 1px solid #D7DEE8;
}

QPushButton[class="danger"], QPushButton#deleteButton {
    background: #D64545;
}

QPushButton[class="success"], QPushButton#saveButton {
    background: #27AE60;
}

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background: #FFFFFF;
    alternate-background-color: #F7F9FC;
    border: 1px solid #E5EAF0;
    border-radius: 8px;
    gridline-color: #E9EEF4;
    selection-background-color: #DCEBFF;
    selection-color: #1F3B5B;
}

QHeaderView::section {
    background: #F0F4F8;
    color: #34495E;
    border: none;
    border-bottom: 1px solid #D7DEE8;
    padding: 9px;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #E5EAF0;
    background: #FFFFFF;
    border-radius: 8px;
}

QTabBar::tab {
    background: #EEF3F8;
    color: #66788A;
    padding: 9px 16px;
    margin-right: 3px;
    border-radius: 7px;
}

QTabBar::tab:selected {
    background: #2F80ED;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: #F0F4F8;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #B8C2CF;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar:horizontal {
    background: #F0F4F8;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #B8C2CF;
    border-radius: 5px;
    min-width: 25px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QToolTip {
    background: #243447;
    color: #FFFFFF;
    border: none;
    padding: 6px;
}
