/* BLOOM FOOD — INPUT COMPONENTS */
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QDateEdit{background-color:#FFFFFF;color:#383E49;border:1px solid #D5D9E2;border-radius:8px;padding:7px 11px;min-height:36px;font-size:10pt;selection-background-color:#DCEBFF;selection-color:#383E49;}
QTextEdit,QPlainTextEdit{background-color:#FFFFFF;color:#383E49;border:1px solid #D5D9E2;border-radius:8px;padding:9px 11px;min-height:88px;font-size:10pt;selection-background-color:#DCEBFF;selection-color:#383E49;}
QLineEdit:hover,QComboBox:hover,QSpinBox:hover,QDoubleSpinBox:hover,QDateEdit:hover,QTextEdit:hover,QPlainTextEdit:hover{border:1px solid #B2D0FF;background-color:#FFFFFF;}
QLineEdit:focus,QComboBox:focus,QSpinBox:focus,QDoubleSpinBox:focus,QDateEdit:focus,QTextEdit:focus,QPlainTextEdit:focus{border:2px solid #1570EF;padding:6px 10px;background-color:#FFFFFF;}
QTextEdit:focus,QPlainTextEdit:focus{padding:8px 10px;}
QLabel#form_label{color:#383E49;font-size:9.5pt;font-weight:700;background:transparent;padding:0;margin:0 0 5px 0;min-height:20px;}
QComboBox{padding-left:11px;padding-right:38px;}
QComboBox::drop-down,QDateEdit::drop-down{width:30px;border:none;background:transparent;}
QComboBox::down-arrow,QDateEdit::down-arrow{image:url(icons/dropdown_chevron.svg);width:14px;height:8px;}
QComboBox QAbstractItemView{background-color:#FFFFFF;color:#383E49;border:1px solid #D5D9E2;border-radius:8px;padding:5px;outline:none;selection-background-color:#E8F1FF;selection-color:#1570EF;}
QSpinBox::up-button,QSpinBox::down-button,QDoubleSpinBox::up-button,QDoubleSpinBox::down-button{width:0;border:none;background:transparent;}
QLabel#input_hint{color:#858D9D;font-size:8.5pt;padding:2px 2px 0 2px;}
QLabel#input_error{color:#F04438;font-size:8.5pt;font-weight:600;padding:3px 2px 0 2px;}
QFrame#transaction_card QLineEdit,QFrame#transaction_card QComboBox,QFrame#transaction_card QSpinBox,QFrame#transaction_card QDoubleSpinBox,QFrame#transaction_card QDateEdit{min-height:38px;}
QFrame#sidebar{background:#FFFFFF;width:244px;min-width:244px;max-width:244px;margin:0;padding:0;border:none;border-radius:0;}
QWidget#sidebar_brand{background:transparent;min-height:58px;}
QLabel#sidebar_logo{background:transparent;min-width:72px;max-width:72px;min-height:58px;max-height:58px;}
QLabel#sidebar_company_name{color:#1570EF;background:transparent;font-size:10pt;font-weight:700;padding:0;}
QToolButton#sidebar_button,QToolButton#sidebar_logout_button{background:transparent;color:#667085;border:none;border-radius:8px;min-height:44px;max-height:44px;padding:0 16px;text-align:left;font-size:10pt;font-weight:600;}
QToolButton#sidebar_button:hover,QToolButton#sidebar_logout_button:hover{background:#F2F6FC;color:#1570EF;}
QToolButton#sidebar_button[active="true"]{background:#E8F1FF;color:#1570EF;}
QToolButton#sidebar_logout_button{color:#F04438;}
QToolButton#sidebar_logout_button:hover{background:#FFF1F0;color:#D92D20;}
QStackedWidget#content_area{background:#F7F9FC;border:none;}
