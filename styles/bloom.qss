/* BLOOM FOOD — UI KIT MASTER THEME */

* {
    font-family: "Inter", "Segoe UI";
    font-size: 10pt;
}

QWidget {
    background: #FFFFFF;
    color: #383E49;
}

QMainWindow, QDialog {
    background: #FFFFFF;
}

QFrame, QGroupBox {
    background: #FFFFFF;
    border: 1px solid #F0F1F3;
    border-radius: 10px;
}

QGroupBox {
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #383E49;
    background: #FFFFFF;
}

QLabel {
    background: transparent;
    color: #5D6679;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D9DDE5;
    border-radius: 8px;
    padding: 8px 10px;
    min-height: 18px;
    selection-background-color: #1570EF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QComboBox:focus {
    border: 1px solid #1570EF;
}

QPushButton {
    background: #1570EF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 9px 16px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #1264D6;
}

QPushButton:pressed {
    background: #0E56B8;
}

QPushButton:disabled {
    background: #D9DDE5;
    color: #858D9D;
}

QPushButton[class="secondary"], QPushButton#secondaryButton {
    background: #F0F1F3;
    color: #383E49;
    border: 1px solid #D9DDE5;
}

QPushButton[class="danger"], QPushButton#deleteButton {
    background: #F04438;
}

QPushButton[class="success"], QPushButton#saveButton {
    background: #12B76A;
}

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background: #FFFFFF;
    alternate-background-color: #FAFBFC;
    border: 1px solid #F0F1F3;
    border-radius: 10px;
    gridline-color: #F0F1F3;
    selection-background-color: #E8F1FF;
    selection-color: #383E49;
}

QHeaderView::section {
    background: #F0F1F3;
    color: #5D6679;
    border: none;
    border-bottom: 1px solid #D9DDE5;
    padding: 9px;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #F0F1F3;
    background: #FFFFFF;
    border-radius: 10px;
}

QTabBar::tab {
    background: #F0F1F3;
    color: #5D6679;
    padding: 9px 16px;
    margin-right: 3px;
    border-radius: 8px;
}

QTabBar::tab:selected {
    background: #1570EF;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: #F0F1F3;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #B8C0CC;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar:horizontal {
    background: #F0F1F3;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #B8C0CC;
    border-radius: 5px;
    min-width: 25px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QToolTip {
    background: #383E49;
    color: #FFFFFF;
    border: none;
    padding: 6px;
}
